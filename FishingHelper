local function resolvePondGeometry(myPlotId)
    myPlotId = myPlotId or lp:GetAttribute("Plot")
    if not myPlotId then return nil end

    local pondTank, cashPrompt, pondCenter, cashPos = nil, nil, nil, nil
    local defendedSpots = {}

    -- เก็บทั้งบ่อดินและตู้ปลานอกบ้านทุกใบ (รวมตู้ที่ใส่แม่กุญแจ Lock 1-3)
    for _, tank in ipairs(cs:GetTagged("HomeTank")) do
        if tank:GetAttribute("Plot") == myPlotId then
            local pos = Modules.getSafeInstancePos(tank)
            if pos then
                table.insert(defendedSpots, { inst = tank, pos = pos, lock = tonumber(tank:GetAttribute("Lock")) or 0 })
            end
            if tank.Name == "PondTank" or tank:GetAttribute("Kind") == "pond" or tank:GetAttribute("Slot") == "pond" then
                pondTank = tank
                pondCenter = pos
            end
        end
    end

    if not pondTank then
        local plots = workspace:FindFirstChild("Town") and workspace.Town:FindFirstChild("Plots")
        local plotFolder = plots and (plots:FindFirstChild("Plot" .. tostring(myPlotId)) or plots:FindFirstChild(tostring(myPlotId)))
        if plotFolder then
            local shop = plotFolder:FindFirstChild("Shop")
            local partPond = shop and shop:FindFirstChild("Part_pond")
            pondTank = partPond and partPond:FindFirstChild("PondTank")
            pondCenter = Modules.getSafeInstancePos(pondTank) or Modules.getSafeInstancePos(partPond)
        end
    end

    for _, prompt in ipairs(cs:GetTagged("PondCash")) do
        if prompt:GetAttribute("Plot") == myPlotId or (prompt.Parent and prompt.Parent:GetAttribute("Plot") == myPlotId) then
            cashPrompt = prompt
            cashPos = getPromptWorldPosition(prompt)
            break
        end
    end

    local homeCenter = pondCenter or Modules.getMyHomePos()
    if not homeCenter then return nil end
    if #defendedSpots == 0 then
        table.insert(defendedSpots, { inst = pondTank, pos = homeCenter, lock = 0 })
    end

    local guardStandCF = cashPos
        and CFrame.lookAt(Vector3.new(cashPos.X, cashPos.Y + 1.5, cashPos.Z + 1.2), Vector3.new(homeCenter.X, cashPos.Y + 1.5, homeCenter.Z))
        or CFrame.lookAt(homeCenter + Vector3.new(0, 3.0, -8), homeCenter)

    return {
        pondTank = pondTank,
        cashPrompt = cashPrompt,
        pondCenter = homeCenter,
        cashPos = cashPos,
        defendedSpots = defendedSpots,
        guardStandCF = guardStandCF
    }
end

function Modules.executePondDefenseCombat(intruderPlr, geo)
    if RUNTIME.isDefendingPond or not intruderPlr then return end
    if typeof(intruderPlr) == "Instance" and intruderPlr:IsA("Model") then
        intruderPlr = Players:GetPlayerFromCharacter(intruderPlr)
    end
    if not intruderPlr then return end

    RUNTIME.isDefendingPond = true
    local prevAutoFish = CFG.AutoFish
    CFG.AutoFish = false
    pcall(function() sendReel(0, true); Input:FireServer("cancel") end)

    notify({
        Title = "🚨 โจรบุกบ้าน! (Home Defense)",
        Content = string.format("ตรวจพบ %s เข้าเขตบ่อ/ตู้ปลา! กำลังไล่ตีจนเข้าคุก (3 ที)", intruderPlr.Name),
        Duration = 4
    })

    Modules.ensureBatEquipped()
    local strikeStart = os.clock()
    local hitsLanded = 0

    -- ไล่ตีจนกว่าโจรจะเข้าคุก (ThiefHits = 3 -> ส่งเข้าสถานีตำรวจ X:-142..-98, Z:-210..-173) หรือหนีพ้น/ออกเกม
    while RUNTIME.alive and (os.clock() - strikeStart) < 28.0 do
        if not intruderPlr.Parent then break end
        local intruderChar = intruderPlr.Character
        local intruderHrp = intruderChar and intruderChar:FindFirstChild("HumanoidRootPart")
        local intruderHum = intruderChar and intruderChar:FindFirstChildOfClass("Humanoid")
        if not (intruderHrp and intruderHum and intruderHum.Health > 0) then break end

        local hrp = getMyHRP()
        if not hrp then break end

        -- เช็คว่าโจรโดนส่งเข้าห้องขังสถานีตำรวจแล้วหรือยัง
        local tp = intruderHrp.Position
        if tp.X >= -145 and tp.X <= -95 and tp.Z >= -215 and tp.Z <= -170 then
            notify({ Title = "🚔 โจรเข้าคุกแล้ว!", Content = intruderPlr.Name .. " ถูกส่งเข้าคุกเรียบร้อย!", Duration = 4 })
            break
        end

        local isDirectThief = (intruderPlr:GetAttribute("ThiefFrom") == lp.UserId) or (intruderPlr:GetAttribute("Thief") == true)
        local distToHome = geo and geo.pondCenter and (tp - geo.pondCenter).Magnitude or 0
        if not isDirectThief and distToHome > 65.0 then break end
        if distToHome > 130.0 and hitsLanded >= 3 then break end

        local distToMe = (tp - hrp.Position).Magnitude
        if distToMe <= 5.5 then
            hrp.CFrame = CFrame.lookAt(hrp.Position, Vector3.new(tp.X, hrp.Position.Y, tp.Z))
            zeroVelocity(hrp)
            Modules.ensureBatEquipped()
            local batTool = lp.Character and lp.Character:FindFirstChildOfClass("Tool")
            if batTool and batTool:GetAttribute("Bat") and typeof(batTool.Activate) == "function" then
                pcall(function() batTool:Activate() end)
            end
            Input:FireServer("bat")
            hitsLanded = hitsLanded + 1
            task.wait(0.58)
        else
            local delta = tp - hrp.Position
            local approachPos = tp - (delta.Magnitude > 0.1 and delta.Unit * 3.2 or Vector3.zero)
            safeGlideTo(CFrame.lookAt(approachPos, tp), 23.0)
            task.wait(0.05)
        end
    end

    if CFG.ReturnToGuardPost and geo and geo.guardStandCF then
        safeGlideTo(geo.guardStandCF, 18.0)
    end

    RUNTIME.isDefendingPond = false
    if not RUNTIME.isGuardingHomeAtNight and prevAutoFish then
        ensureRodEquipped()
        CFG.AutoFish = true
        if RUNTIME.phase == "idle" and not isBusy() then
            task.spawn(doAutoCast)
        end
    end
end

function Modules.updatePondGuardEngine(now)
    if not (CFG.PondGuard or CFG.NightHomeDefense) then return end
    if isBusy() and RUNTIME.busyMode ~= "pondGuard" then return end
    if (now - (RUNTIME.lastPondGuardCheckAt or 0)) < 0.50 then return end
    RUNTIME.lastPondGuardCheckAt = now

    local myPlot = lp:GetAttribute("Plot")
    if not myPlot then return end
    local hrp = getMyHRP()
    if not hrp then return end

    local clockTime = Lighting.ClockTime
    local needGoHome = (clockTime >= 18.35 or clockTime < 5.55)   -- เริ่มขับเรือกลับบ้าน 18:20 เฝ้าจน 05:33
    local isStealWindow = (clockTime >= 18.85 or clockTime < 5.55)
    local isMorning = (clockTime >= 5.55 and clockTime < 18.35)

    -- [SUB-ROUTINE 0]: ระบบกลับบ้านเฝ้ากลางคืนอัตโนมัติ (อยู่ที่ไหนก็ตามรวมอ่างเก็บน้ำ -> กลับบ้านเฝ้า -> เช้ากลับหมายเดิม)
    if CFG.NightHomeDefense then
        local homePos = Modules.getMyHomePos()
        if needGoHome and not RUNTIME.isGuardingHomeAtNight and not RUNTIME.isReturningHomeForNight and homePos then
            local curPh = lp:GetAttribute("FishPhase") or RUNTIME.phase or "idle"
            if curPh ~= "fight" and curPh ~= "strike" and curPh ~= "landing" then
                RUNTIME.isReturningHomeForNight = true
                RUNTIME.preGuardAutoFish = CFG.AutoFish
                RUNTIME.preGuardFishingCF = ((hrp.Position - homePos).Magnitude > 60) and hrp.CFrame or RUNTIME.lastFishingSpotCF
                CFG.AutoFish = false
                task.spawn(function()
                    if Modules.recallAllRodsOnStop then Modules.recallAllRodsOnStop() end
                    notify({
                        Title = "🌙 เวลาเฝ้าบ้าน · กำลังเดินทางกลับบ้าน!",
                        Content = "วางแผนเส้นทางข้ามโซนอัตโนมัติ (เรือ + มอเตอร์ไซค์/รถ 50 studs/s ข้ามเขื่อน/สะพาน) กลับเฝ้าบ้าน",
                        Duration = 5
                    })
                    local arrived = Modules.boatAutoTravelTo(CFrame.new(homePos + Vector3.new(0, 3.0, 0)), "บ้านของฉัน")
                    local curHrp = getMyHRP()
                    local atHome = curHrp and (curHrp.Position - homePos).Magnitude <= 95.0
                    if not atHome and curHrp then
                        -- สำรองฉุกเฉิน: วิ่งบนบกตรงไปบ้านจนถึงแน่นอน
                        Modules.safeOverlandTravel(CFrame.new(homePos + Vector3.new(0, 3.0, 0)), 22.0)
                        curHrp = getMyHRP()
                        atHome = curHrp and (curHrp.Position - homePos).Magnitude <= 95.0
                    end
                    RUNTIME.isReturningHomeForNight = false
                    if arrived or atHome then
                        RUNTIME.isGuardingHomeAtNight = true
                        local g = resolvePondGeometry(myPlot)
                        if g and g.guardStandCF then safeGlideTo(g.guardStandCF, 18.0) end
                        Modules.ensureBatEquipped()
                        notify({ Title = "🛡️ ถึงบ้านแล้ว · เฝ้าบ้านพร้อมตีโจร!", Content = "กำลังเฝ้าบ่อดินและตู้ปลาข้างนอกทุกใบจนถึง 05:35 น.", Duration = 4 })
                    else
                        -- หากยังไปไม่ถึงจริง ไม่ล็อกค้างไว้ ให้ลองใหม่รอบหน้าได้
                        RUNTIME.isGuardingHomeAtNight = false
                    end
                end)
                return
            end
        elseif isMorning and RUNTIME.isGuardingHomeAtNight then
            RUNTIME.isGuardingHomeAtNight = false
            task.spawn(function()
                if CFG.AutoMorningCollect then
                    local g = resolvePondGeometry(myPlot)
                    if g and g.cashPos then
                        safeGlideTo(CFrame.new(g.cashPos + Vector3.new(0, 1.5, 1.0)), 14.0)
                        task.wait(0.2)
                    end
                    Input:FireServer("pondCash")
                    if g and g.cashPrompt and typeof(fireproximityprompt) == "function" then
                        pcall(fireproximityprompt, g.cashPrompt)
                    end
                    if CFG.AutoFeedPond then
                        task.wait(0.3)
                        Input:FireServer("feed", "pond")
                        Input:FireServer("feedLive", "pond")
                    end
                    task.wait(0.4)
                end

                local backCF = RUNTIME.preGuardFishingCF or RUNTIME.lastFishingSpotCF
                if backCF then
                    notify({
                        Title = "🌅 เช้าแล้ว! กลับหมายตกปลาเดิม",
                        Content = "เก็บเงินบ่อเรียบร้อย กำลังเดินทางกลับจุดตกปลาเดิม...",
                        Duration = 5
                    })
                    Modules.boatAutoTravelTo(backCF, "หมายตกปลาเดิม", { equipRod = true })
                    if Modules.ensureSafeWaterFooting then
                        Modules.ensureSafeWaterFooting(backCF)
                    end
                end
                CFG.AutoFish = (RUNTIME.preGuardAutoFish ~= false)
                RUNTIME.lastCastAt = 0
            end)
            return
        end
    end

    local geo = resolvePondGeometry(myPlot)
    if not geo or not geo.pondCenter then return end
    RUNTIME.pondCenterPos = geo.pondCenter
    if geo.guardStandCF then RUNTIME.guardStandCF = geo.guardStandCF end

    -- [SUB-ROUTINE 1]: เก็บเงินบ่อดินยามเช้า (กรณียืนอยู่ใกล้บ้านอยู่แล้ว)
    if CFG.AutoMorningCollect and isMorning and (RUNTIME.wasNight or (now - (RUNTIME.lastPondCollectAt or 0)) >= 60.0) then
        local distToCash = geo.cashPos and (hrp.Position - geo.cashPos).Magnitude or 999
        if distToCash <= 35.0 then
            Input:FireServer("pondCash")
            if geo.cashPrompt and typeof(fireproximityprompt) == "function" then
                pcall(function() fireproximityprompt(geo.cashPrompt) end)
            end
            RUNTIME.lastPondCollectAt = now
            if CFG.AutoFeedPond then
                task.delay(0.5, function()
                    Input:FireServer("feed", "pond")
                    Input:FireServer("feedLive", "pond")
                end)
            end
        end
        RUNTIME.wasNight = false
    elseif isStealWindow then
        RUNTIME.wasNight = true
    end

    -- [SUB-ROUTINE 2]: ตรวจจับโจรทั้งรอบบ่อดินและตู้ปลาข้างนอกทุกใบ (รวมตู้ใส่แม่กุญแจ)
    if CFG.AutoBeatThieves and not RUNTIME.isDefendingPond and (hrp.Position - geo.pondCenter).Magnitude <= 145 then
        local targetPlr, threatLevel = nil, 0
        local maxRange = CFG.PondGuardRange or 35.0

        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= lp and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
                local pPos = plr.Character.HumanoidRootPart.Position
                local pHum = plr.Character:FindFirstChildOfClass("Humanoid")
                if pHum and pHum.Health > 0 then
                    local minSpotDist = math.huge
                    for _, sp in ipairs(geo.defendedSpots) do
                        local d = (pPos - sp.pos).Magnitude
                        if d < minSpotDist then minSpotDist = d end
                    end

                    if plr:GetAttribute("ThiefFrom") == lp.UserId then
                        targetPlr, threatLevel = plr, 3; break
                    elseif plr:GetAttribute("Thief") == true and minSpotDist <= 55.0 and threatLevel < 2 then
                        targetPlr, threatLevel = plr, 2
                    elseif isStealWindow and minSpotDist <= maxRange and threatLevel < 1 then
                        targetPlr, threatLevel = plr, 1
                    end
                end
            end
        end

        if targetPlr then
            task.spawn(Modules.executePondDefenseCombat, targetPlr, geo)
        end
    end
end

function Modules.updatePlotAndPondCollector(now)
