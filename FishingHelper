function boatNav.canUseGamepassWarp(destId)
    local perk = FishingRemotes and FishingRemotes:FindFirstChild("Perk")
    if not perk then return false, "no_remote", 0 end
    if lp:GetAttribute("Pass_warp") ~= true then return false, "no_pass", 0 end
    if destId and not VALID_WARP_IDS[destId] then return false, "invalid_dest", 0 end
    local rem = boatNav.getWarpCooldownRemaining()
    if rem > 0 then return false, "cooldown", rem end
    return true, "ok", 0
end

function boatNav.tryGamepassWarp(destId, verifyTimeout)
    local ok, reason, rem = boatNav.canUseGamepassWarp(destId)
    if not ok then
        return false, reason, rem
    end

    local perk = FishingRemotes and FishingRemotes:FindFirstChild("Perk")
    if not perk then return false, "no_remote", 0 end

    local char = lp.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    local startPos = root and root.Position or Vector3.zero

    pcall(function()
        if sendReel then sendReel(0, true) end
        if setSteer then setSteer(0, true) end
        if Input then Input:FireServer("cancel") end
    end)

    perk:FireServer("warp", destId)

    local t0 = os.clock()
    local limit = verifyTimeout or 3.5
    while RUNTIME.alive and (os.clock() - t0) < limit do
        task.wait(0.15)
        local curRoot = lp.Character and lp.Character:FindFirstChild("HumanoidRootPart")
        if curRoot and (curRoot.Position - startPos).Magnitude > 25 then
            return true, "warped", 0
        end
        if boatNav.getWarpCooldownRemaining() > 10 then
            return true, "warped", 0
        end
    end

    return false, "timeout", 0
end

function boatNav.mapTargetToWarpDest(targetCF, name)
    if not targetCF then return nil end
    local pos = typeof(targetCF) == "CFrame" and targetCF.Position or targetCF
    local n = tostring(name or ""):lower()

    if n:find("home") or n:find("plot") or n:find("บ่อส่วนตัว") or n:find("บ้าน") then
        return "home"
    end
    if n:find("plaza") or n:find("market") or n:find("ร้าน") or n:find("ตลาด") or n:find("เคาน์เตอร์") or n:find("ลุงเบ็ด") or n:find("ป้าบัว") then
        return "plaza"
    end
    if n:find("reservoir") or n:find("dam") or n:find("เขื่อน") or n:find("อ่างเก็บน้ำ") then
        return "reservoir"
    end
    if n:find("upstream") or n:find("waterfall") or n:find("แก่งหิน") or n:find("น้ำตก") or n:find("ต้นน้ำ") then
        return "upstream"
    end
    if n:find("mangrove") or n:find("swamp") or n:find("ป่าชายเลน") or n:find("ชายเลน") then
        return "mangrove"
    end
    if n:find("river") or n:find("estuary") or n:find("แม่น้ำ") or n:find("ปากอ่าว") or n:find("หาด") then
        return "river"
    end

    local sellStand = VENDOR_COORDINATES and VENDOR_COORDINATES.sell and VENDOR_COORDINATES.sell.stand or Vector3.new(-18, 8, 7.6)
    if (pos - sellStand).Magnitude < 120 then
        return "plaza"
    end
    if pos.Z <= -140 then
        return "reservoir"
    end
    if pos.X <= -300 and pos.Z <= 500 then
        if pos.Z <= 100 and pos.X <= -600 then
            return "mangrove"
        else
            return "upstream"
        end
    end
    if pos.Z >= 280 then
        return "river"
    end

    return "plaza"
end

