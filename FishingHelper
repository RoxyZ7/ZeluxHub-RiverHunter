            RUNTIME.lastMovementAt = os.clock()
            if hum.WalkSpeed < 16 then
                hum.WalkSpeed = 16
                hum.JumpHeight = 7.2
                hum.JumpPower = 50
            end
        elseif (RUNTIME.phase == "idle" or not isRodEquipped()) and not RUNTIME.isPilotingBoat and not RUNTIME.isRoundTripping then
            if hum.WalkSpeed < 16 then
                hum.WalkSpeed = 16
                hum.JumpHeight = 7.2
                hum.JumpPower = 50
            end
        end
    end
end))

