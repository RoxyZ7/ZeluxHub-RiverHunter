function boatNav.tryRiderSellAll(opts)
    opts = opts or {}
    local keepFav = (opts.keepFav ~= false)
    local keepKingbuk = (opts.keepKingbuk == true)

    local ok, reason, rem = boatNav.canUseRiderSell()
    if not ok then
        return false, reason, rem
    end

    local perk = FishingRemotes and FishingRemotes:FindFirstChild("Perk")
    if not perk then return false, "no_remote", 0 end

    local done = false
    local soldCount = 0
    local status = "timeout"
    local conn

    conn = perk.OnClientEvent:Connect(function(ev, list)
        if ev == "riderHere" and typeof(list) == "table" then
            local uids = {}
            for _, fish in ipairs(list) do
                if typeof(fish) == "table" and fish.uid ~= nil then
                    local isFav = (fish.fav == true or fish.secret == true)
                    local sp = tostring(fish.species or fish.id or fish.name or ""):lower()
                    local isKingbuk = (sp:find("kingbuk") or sp:find("giant_catfish") or sp:find("บึกยักษ์") or sp:find("พญาบึก"))
                    if not (keepFav and isFav) and not (keepKingbuk and isKingbuk) then
                        table.insert(uids, fish.uid)
                    end
                end
            end

            if #uids > 0 then
                perk:FireServer("riderSell", uids)
                soldCount = #uids
                status = "sold"
            else
                perk:FireServer("riderCancel")
                status = "nothing_to_sell"
            end
            done = true
        elseif ev == "riderGone" then
            if not done then
                status = "rider_gone"
                done = true
            end
        end
    end)

    perk:FireServer("rider")

    local t0 = os.clock()
    local limit = opts.timeout or 12.0
    while RUNTIME.alive and not done and (os.clock() - t0) < limit do
        task.wait(0.10)
    end

    if conn then
        conn:Disconnect()
    end

    if status == "sold" then
        task.wait(0.40)
        return true, status, soldCount
    end
    return false, status, soldCount
end

-- เช็คผิวน้ำจริงรอบตัวเรือ (WaterFX.boatWater + nearLine)
function boatNav.isWaterNavigable(x, z, waterY, requireStreamedTerrain)
    local wy = waterY or boatNav.getWaterY(x, z)
    local nl = RUNTIME and RUNTIME.boatNearLineFn
    if typeof(nl) == "function" then
        local ok, blocked = pcall(nl, x, z, 4.0)
        if ok and blocked then return false end
    end

    if requireStreamedTerrain then
        local wf = boatNav.WaterFX
        if wf and typeof(wf.boatWater) == "function" then
            local ok, isWater = pcall(wf.boatWater, Vector3.new(x, wy, z))
            if ok and not isWater then return false end
        end
    end
    return true
end

-- หาร่องน้ำที่กว้างและปลอดภัยที่สุด ณ ตำแหน่ง Z (เลือก Open Run ที่กว้างที่สุด เลี่ยงเกาะ/หิน/แพ)
function boatNav.findBestChannelX(z, preferX, boatModel, char)
    local tp = boatNav.TownPlan
    if not (tp and typeof(tp.riverCX) == "function" and typeof(tp.riverHalf) == "function") then
        return preferX
    end

    local cx = tp.riverCX(z)
    local half = tp.riverHalf(z)
    local minX = cx - math.max(8, half - 11)
    local maxX = cx + math.max(8, half - 11)
    if minX >= maxX then return cx end

    local myPos = (char and char:FindFirstChild("HumanoidRootPart") and char.HumanoidRootPart.Position)
    local isNearStreamed = myPos and (math.abs(z - myPos.Z) <= 260) or false
    local wy = boatNav.getWaterY(cx, z)
    local rpSolid = isNearStreamed and boatNav.makeSolidRayParams(boatModel, char) or nil

    local function cellOpen(x)
        if not boatNav.isPointSafeMath(x, z, 10.0) then return false end
        if isNearStreamed then
            if not boatNav.isWaterNavigable(x, z, wy, true) then return false end
            if boatNav.hitsSolidObstacle(Vector3.new(x - 5, wy + 1.2, z), Vector3.new(x + 5, wy + 1.2, z), rpSolid) then
                return false
            end
            if boatNav.hitsSolidObstacle(Vector3.new(x - 5, wy + 0.65, z), Vector3.new(x + 5, wy + 0.65, z), rpSolid) then
                return false
            end
        end
        return true
    end

    local step, runs, curRun = 6, {}, nil
    local x = minX
    while x <= maxX do
        if cellOpen(x) then
            if not curRun then curRun = { s = x, e = x } else curRun.e = x end
        else
            if curRun then table.insert(runs, curRun); curRun = nil end
        end
        x = x + step
    end
    if curRun then table.insert(runs, curRun) end

    if #runs == 0 then return math.clamp(preferX or cx, minX, maxX) end

    local bestX, bestScore = cx, -1e9
    for _, run in ipairs(runs) do
        local width = run.e - run.s
        local candidate = (run.s + run.e) * 0.5
        if preferX and width >= 28 then
            candidate = math.clamp(preferX, run.s + 12, run.e - 12)
        end
        local score = (width * 2.2) - (math.abs(candidate - (preferX or cx)) * 0.18)
        if score > bestScore then
            bestScore = score
            bestX = candidate
        end
    end
    return bestX
end

function boatNav.shiftToOpenWater(pos, boatModel, char)
    if pos.Z >= 280 then
        local bestX = boatNav.findBestChannelX(pos.Z, pos.X, boatModel, char)
        return Vector3.new(bestX, pos.Y, pos.Z)
    end
    return pos
end

do
    local BoatPhysics = pcall(function() return require(Shared:WaitForChild("BoatPhysics")) end) and require(Shared:WaitForChild("BoatPhysics")) or nil
    local originalBoatPhysicsStep = getgenv()._originalBoatPhysicsStep

    if not originalBoatPhysicsStep and BoatPhysics and typeof(BoatPhysics.step) == "function" then
        originalBoatPhysicsStep = BoatPhysics.step
        getgenv()._originalBoatPhysicsStep = originalBoatPhysicsStep
    end

    -- เรดาร์พัด 11 แฉก ครอบคลุม -80 ถึง +80 องศา สแกนไกล 60 สตัด
    local RADAR_RADS = {
        math.rad(-80), math.rad(-62), math.rad(-46), math.rad(-30), math.rad(-15),
        0,
        math.rad(15), math.rad(30), math.rad(46), math.rad(62), math.rad(80)
    }
    local RADAR_DISTS = { 6, 12, 18, 25, 33, 42, 51, 60 }

    if BoatPhysics and typeof(BoatPhysics.step) == "function" and originalBoatPhysicsStep then
        BoatPhysics.step = function(st, ctrl, cfg, water, dt)
            local canAutopilot = false
            local boatModel, char
            if RUNTIME and RUNTIME.alive and RUNTIME.boatAutoTarget
                and typeof(st) == "table" and typeof(ctrl) == "table" then
                char = lp.Character
                local hum = char and char:FindFirstChildOfClass("Humanoid")
                local seat = hum and hum.SeatPart
                if hum and hum.Sit and seat and seat.Name == "DriverSeat"
                    and seat.Parent and seat.Parent:GetAttribute("Owner") == lp.UserId then
                    canAutopilot = true
                    boatModel = seat.Parent
                    if typeof(water) == "table" then
                        boatNav.extractNearLine(water.canGo)
                    end
                    RUNTIME.boatWaterY = boatNav.getWaterY(st.x, st.z)
                end
            end

            if canAutopilot then
                local now = os.clock()
                local fx, fz = BoatPhysics.forward(st.yaw)
                local rx, rz = -fz, fx
                local vForward = (st.vx * fx) + (st.vz * fz)
                local wy = RUNTIME.boatWaterY or 0

                if (now - (RUNTIME.boatRadarAt or 0)) >= 0.08 or not RUNTIME.boatCachedCtrl then
                    RUNTIME.boatRadarAt = now
                    local curX, curZ = st.x, st.z
                    local wp = RUNTIME.boatAutoTarget
                    local dx, dz = wp.X - curX, wp.Z - curZ
                    local distWp = math.sqrt(dx * dx + dz * dz)

                    if distWp <= 4.0 then
                        RUNTIME.boatCachedCtrl = { throttle = 0, steer = 0 }
                    else
                        local rpSolid = boatNav.makeSolidRayParams(boatModel, char)
                        local hullHalfLen = (boatModel and tonumber(boatModel:GetAttribute("BoatLen")) or 14) * 0.5
                        local shoulderOff = 4.2 -- เผื่อกราบเรือซ้าย-ขวา กันเฉี่ยว BoatBlock และตอม่อ
                        local rayHeights = { wy + 1.20, wy + 0.65 }
                        local rawClear = {}

                        for i = 1, 11 do
                            local rad = RADAR_RADS[i]
                            local ca, sa = math.cos(rad), math.sin(rad)
                            local dirX = fx * ca + rx * sa
                            local dirZ = fz * ca + rz * sa
                            local perpX, perpZ = -dirZ, dirX
                            local maxClear = 60

                            -- 1. จับ BoatBlock / DriftLog / Rock / Pier / RaftDeck (3 เส้นขนาน x 2 ความสูง)
                            for _, sOff in ipairs({ 0, -shoulderOff, shoulderOff }) do
                                local ox = curX + perpX * sOff
                                local oz = curZ + perpZ * sOff
                                for _, yRay in ipairs(rayHeights) do
                                    local pStart = Vector3.new(ox, yRay, oz)
                                    local pEnd = Vector3.new(ox + dirX * maxClear, yRay, oz + dirZ * maxClear)
                                    local blocked, hit = boatNav.hitsSolidObstacle(pStart, pEnd, rpSolid)
                                    if blocked and hit then
                                        maxClear = math.min(maxClear, math.max(0, hit.Distance - hullHalfLen))
                                    end
                                end
                            end

                            -- 2. จับเกาะ สันทราย ตลิ่ง น้ำตื้น ด้วย WaterFX.boatWater + nearLine
                            for _, d in ipairs(RADAR_DISTS) do
                                if d > maxClear then break end
                                local px = curX + dirX * (d + hullHalfLen * 0.45)
                                local pz = curZ + dirZ * (d + hullHalfLen * 0.45)
                                local okMid = boatNav.isWaterNavigable(px, pz, wy, true) and boatNav.isPointSafeMath(px, pz, 10.0, 7.0)
                                local okL = boatNav.isWaterNavigable(px - perpX * shoulderOff, pz - perpZ * shoulderOff, wy, true) and boatNav.isPointSafeMath(px - perpX * shoulderOff, pz - perpZ * shoulderOff, 10.0, 7.0)
                                local okR = boatNav.isWaterNavigable(px + perpX * shoulderOff, pz + perpZ * shoulderOff, wy, true) and boatNav.isPointSafeMath(px + perpX * shoulderOff, pz + perpZ * shoulderOff, 10.0, 7.0)
                                if not (okMid and okL and okR) then
                                    maxClear = math.min(maxClear, math.max(0, d - 5))
                                    break
                                end
                            end
                            rawClear[i] = maxClear
                        end

                        local safeClear = {}
                        for i = 1, 11 do
                            local lC = rawClear[i - 1] or rawClear[i]
                            local rC = rawClear[i + 1] or rawClear[i]
                            safeClear[i] = math.min(rawClear[i], lC + 9, rC + 9)
                        end

                        local leftSum = rawClear[1] + rawClear[2] + rawClear[3] + rawClear[4] + rawClear[5]
                        local rightSum = rawClear[7] + rawClear[8] + rawClear[9] + rawClear[10] + rawClear[11]
                        local sternX, sternZ = curX - fx * (hullHalfLen + 4), curZ - fz * (hullHalfLen + 4)
                        local sternClear = boatNav.isWaterNavigable(sternX, sternZ, wy, true)
                            and not boatNav.hitsSolidObstacle(Vector3.new(curX, wy + 1.2, curZ), Vector3.new(sternX, wy + 1.2, sternZ), rpSolid)

                        if (RUNTIME.boatReverseUntil or 0) > now then
                            if (rawClear[6] >= 22 and (rawClear[5] >= 16 or rawClear[7] >= 16)) or not sternClear then
                                RUNTIME.boatReverseUntil = 0
                            end
                        elseif rawClear[6] <= 6 and rawClear[5] <= 10 and rawClear[7] <= 10 and sternClear then
                            RUNTIME.boatReverseUntil = now + 1.2
                            RUNTIME.boatWantYawSign = (rightSum >= leftSum) and -1 or 1
                        end

                        if (RUNTIME.boatReverseUntil or 0) > now then
                            local wantYaw = RUNTIME.boatWantYawSign or -1
                            -- ชดเชยการกลับด้านพวงมาลัยตอนถอยหลังของ BoatPhysics (v9 = -1)
                            local steerCmd = (vForward >= 0) and (-wantYaw) or wantYaw
                            RUNTIME.boatCachedCtrl = { throttle = -0.85, steer = steerCmd }
                        else
                            local tx, tz = dx / distWp, dz / distWp
                            local targetAngle = math.atan2(tx * rx + tz * rz, tx * fx + tz * fz)

                            if rawClear[6] >= 48 and safeClear[6] >= 40 and math.abs(targetAngle) <= math.rad(14) then
                                RUNTIME.boatDodgeSide = nil
                                RUNTIME.boatCachedCtrl = {
                                    throttle = 1.0,
                                    steer = math.clamp(targetAngle * 1.8, -1, 1)
                                }
                            else
                                local dodging = (rawClear[6] < 42)
                                local bestIdx, bestScore = 6, -1e9
                                for i = 1, 11 do
                                    local rad = RADAR_RADS[i]
                                    local angleDiff = math.abs(rad - targetAngle)
                                    local score = (safeClear[i] * 1.8) - (angleDiff * 18.0)
                                    -- Hysteresis: จำฝั่งหลบเกาะ ไม่ให้หักซ้ายสลับขวาเข้ากลางเกาะ
                                    if dodging and RUNTIME.boatDodgeSide then
                                        if (RUNTIME.boatDodgeSide > 0 and rad > 0) or (RUNTIME.boatDodgeSide < 0 and rad < 0) then
                                            score = score + 14.0
                                        end
                                    end
                                    if safeClear[i] < 14 then score = score - 60.0 end
                                    if score > bestScore then
                                        bestScore = score
                                        bestIdx = i
                                    end
                                end

                                local chosenRad = RADAR_RADS[bestIdx]
                                if dodging and chosenRad ~= 0 then
                                    RUNTIME.boatDodgeSide = (chosenRad > 0) and 1 or -1
                                end

                                local steerVal = math.clamp(chosenRad * 1.5, -1, 1)
                                local throttleVal = 1.0
                                if safeClear[bestIdx] < 18 or rawClear[6] < 18 then
                                    throttleVal = 0.35
                                elseif rawClear[6] < 32 or math.abs(steerVal) > 0.65 then
                                    throttleVal = 0.60
                                end
                                RUNTIME.boatCachedCtrl = { throttle = throttleVal, steer = steerVal }
                            end
                        end
                    end
                end

                local c = RUNTIME.boatCachedCtrl
                if c then
                    ctrl.throttle = c.throttle
                    ctrl.steer = c.steer
                end
            end

            local res = originalBoatPhysicsStep(st, ctrl, cfg, water, dt)

            -- จับสัญญาณชนจริงจาก st.hit ในเฟรมแรกทันที
            if canAutopilot and (st.hit or 0) >= 0.95 then
                local now = os.clock()
                if (now - (RUNTIME.boatLastHitAt or 0)) <= 1.2 then
                    RUNTIME.boatHitStreak = (RUNTIME.boatHitStreak or 0) + 1
                else
                    RUNTIME.boatHitStreak = 1
                end
                RUNTIME.boatLastHitAt = now

                if RUNTIME.boatHitStreak >= 3 and (RUNTIME.boatReverseUntil or 0) <= now then
                    RUNTIME.boatHitStreak = 0
                    RUNTIME.boatReverseUntil = now + 1.2
                    RUNTIME.boatWantYawSign = (RUNTIME.boatDodgeSide and -RUNTIME.boatDodgeSide) or -1
                    RUNTIME.boatDodgeSide = (RUNTIME.boatWantYawSign == -1) and 1 or -1
                    RUNTIME.boatRadarAt = 0
                end
            end

            return res
        end
    end
end

