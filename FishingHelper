function boatNav.getWaterY(x, z)
    local wf = boatNav.WaterFX
    if wf and typeof(wf.waterY) == "function" then
        local ok, wy = pcall(wf.waterY, Vector3.new(x or 0, 0, z or 300))
        if ok and typeof(wy) == "number" then return wy end
    end
