log = function(msg) print("[HunterSuite]", tostring(msg)) end

local function getMyHRP()
    local char = lp.Character
    return char and char:FindFirstChild("HumanoidRootPart")
end

local function zeroVelocity(hrp)
    if not hrp then return end
    hrp.AssemblyLinearVelocity = Vector3.zero
    hrp.AssemblyAngularVelocity = Vector3.zero
end

local flashSafetyPad = nil
local flashPadToken = 0

local function ensureFlashPad(pos)
    flashPadToken = flashPadToken + 1
    if not (flashSafetyPad and flashSafetyPad.Parent) then
        local p = Instance.new("Part")
        p.Name = "HunterSuite_FlashPad"
        p.Size = Vector3.new(24, 2, 24)
        p.Anchored = true
        p.CanCollide = true
        p.Transparency = 1
        p.Parent = workspace
        flashSafetyPad = p
    end
    flashSafetyPad.CFrame = CFrame.new(pos.X, pos.Y - 4.0, pos.Z)
    return flashSafetyPad, flashPadToken
end

local function clearFlashPad(delaySec, expectedToken)
    local tokenNow = expectedToken or flashPadToken
    if delaySec and delaySec > 0 then
        task.delay(delaySec, function()
            if flashPadToken == tokenNow and flashSafetyPad and flashSafetyPad.Parent then
                pcall(function() flashSafetyPad:Destroy() end)
                flashSafetyPad = nil
            end
        end)
        return
    end
    if flashSafetyPad and flashSafetyPad.Parent then
        pcall(function() flashSafetyPad:Destroy() end)
    end
    flashSafetyPad = nil
end

local function isGroundStreamedUnder(pos)
    local rp = RaycastParams.new()
    local excl = {}
    if lp.Character then table.insert(excl, lp.Character) end
    if flashSafetyPad then table.insert(excl, flashSafetyPad) end
    rp.FilterDescendantsInstances = excl
    rp.FilterType = Enum.RaycastFilterType.Exclude
    rp.IgnoreWater = false
    return workspace:Raycast(pos + Vector3.new(0, 8, 0), Vector3.new(0, -35, 0), rp) ~= nil
end

local function setAntiSeatLock(hum, locked)
    if not hum then return end
    pcall(function()
        hum:SetStateEnabled(Enum.HumanoidStateType.Seated, not locked)
    end)
end

local function forceUnseat(hum, hrp)
    if not hum then return end
    setAntiSeatLock(hum, true)
    if hum.SeatPart then
        local weld = hum.SeatPart:FindFirstChild("SeatWeld")
        if weld then pcall(function() weld:Destroy() end) end
    end
    if hum.Sit or hum.SeatPart ~= nil then
        hum.Sit = false
        pcall(function() hum:ChangeState(Enum.HumanoidStateType.GettingUp) end)
        if hrp and hrp.Parent then
            hrp.CFrame = hrp.CFrame + Vector3.new(0, 2.5, 0)
            zeroVelocity(hrp)
        end
        local t0 = os.clock()
        while (os.clock() - t0) < 0.50 and (hum.Sit or hum.SeatPart ~= nil) do
            if hum.SeatPart then
                local w = hum.SeatPart:FindFirstChild("SeatWeld")
                if w then pcall(function() w:Destroy() end) end
            end
            hum.Sit = false
            RunService.Heartbeat:Wait()
        end
    end
end

local function resumeFishingAfterWarp()
    local char = lp.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local hrp = getMyHRP()

    if hum then
        forceUnseat(hum, hrp)
        hum.PlatformStand = false
        hum.WalkSpeed = 16
        hum.JumpHeight = 7.2
        hum.JumpPower = 50
        -- ปลดล็อกให้กลับมานั่งเรือได้ปกติหลังยืนนิ่งบนฝั่งแล้ว 0.5 วิ
        task.delay(0.50, function()
            if hum and hum.Parent then setAntiSeatLock(hum, false) end
        end)
    end

    -- รีเซ็ตสถานะเบ็ดให้พร้อมตีสายต่อทันที
    RUNTIME.phase = "idle"
    RUNTIME.isNibbling = false
    RUNTIME.cancellingLure = nil
    RUNTIME.plantFreePendingUntil = 0
    RUNTIME.lastPlantActionAt = 0
    RUNTIME.lastCastAt = 0
    RUNTIME.lastManualCancelAt = 0
    RUNTIME.lastMovementAt = 0
    RUNTIME.lastIdleActionAt = os.clock()
    if (lp:GetAttribute("BucketN") or 0) < getBucketCap() then
        RUNTIME.pending = nil
    end
    syncClientPhase("idle")

    -- พยายามหยิบคันเบ็ดคืนจนกว่าจะถือติดมือจริง
    if CFG.AutoEquipRod then
        for _ = 1, 5 do
            if isRodEquipped() then break end
            ensureRodEquipped()
            task.wait(0.12)
        end
    end

    if CFG.AutoFish and CFG.AutoCast then
        task.delay(0.30, function()
            if RUNTIME.alive and CFG.AutoFish and CFG.AutoCast and not isBusy() and doAutoCast then
                doAutoCast()
            end
        end)
    end
end

local function flashWarpSynced(hrp, targetCF, settleSec, waitForGround)
    if not (hrp and hrp.Parent) then return false end
    local char = lp.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")

    -- บล็อกการนั่ง + ทำลาย SeatWeld ให้ขาดก่อนวาร์ปทุกครั้ง
    forceUnseat(hum, hrp)

    local safeCF = targetCF + Vector3.new(0, 1.0, 0)
    local dist = (hrp.Position - safeCF.Position).Magnitude
    ensureFlashPad(safeCF.Position)
    hrp.Anchored = false

    local function snapOnce(offsetX)
        if hum and (hum.Sit or hum.SeatPart ~= nil) then
            forceUnseat(hum, hrp)
        end
        local cf = offsetX and (safeCF * CFrame.new(offsetX, 0, 0)) or safeCF
        if char and char.PrimaryPart then
            char:PivotTo(cf)
        else
            hrp.CFrame = cf
        end
        zeroVelocity(hrp)
    end

    snapOnce(0)
    local holdFor = settleSec or (dist > 150 and 0.42 or 0.22)
    local t0 = os.clock()
    local nudge = 0.03
    while RUNTIME.alive and hrp.Parent and (os.clock() - t0) < holdFor do
        nudge = -nudge
        snapOnce(nudge)
        RunService.Heartbeat:Wait()
    end

    if waitForGround and dist > 100 then
        local g0 = os.clock()
        while RUNTIME.alive and hrp.Parent and (os.clock() - g0) < 3.5 do
            if isGroundStreamedUnder(safeCF.Position) and (hrp.Position - safeCF.Position).Magnitude <= 12 then
                break
            end
            snapOnce(0)
            RunService.Heartbeat:Wait()
        end
    end

    snapOnce(0)
    return (hrp.Position - safeCF.Position).Magnitude <= 15
end

local function returnToFishingSpot(originCF)
    if not originCF then return false end
    for _ = 1, 3 do
        local hrp = getMyHRP()
        local hum = lp.Character and lp.Character:FindFirstChildOfClass("Humanoid")
        if not hrp then
            task.wait(0.25)
        else
            forceUnseat(hum, hrp)
            local dist = (hrp.Position - originCF.Position).Magnitude
            if dist <= 12 and isGroundStreamedUnder(originCF.Position) then
                zeroVelocity(hrp)
                return true
            end
            flashWarpSynced(hrp, originCF, dist > 120 and 0.45 or 0.18, true)
            task.wait(0.18)
            hrp = getMyHRP()
            if hrp and (hrp.Position - originCF.Position).Magnitude <= 15 then
                return true
            end
        end
    end
    return false
end

local function isWaterUnderPosition(pos)
    local rp = RaycastParams.new()
    local excl = {}
    if lp.Character then table.insert(excl, lp.Character) end
    if flashSafetyPad then table.insert(excl, flashSafetyPad) end
    if RUNTIME.eventPlatform then table.insert(excl, RUNTIME.eventPlatform) end
    rp.FilterDescendantsInstances = excl
    rp.FilterType = Enum.RaycastFilterType.Exclude
    rp.IgnoreWater = false
    local hit = workspace:Raycast(pos + Vector3.new(0, 8, 0), Vector3.new(0, -35, 0), rp)
    return hit == nil or hit.Material == Enum.Material.Water
end

-- ระบบวาร์ปปลอดภัยมาตรฐานเดียวกับระบบขายปลา (ไม่โดนเตะ Error 267, ไม่ติดเก้าอี้, ไม่ตกแมพ)
local function safeWarpToCFrame(targetCF, opts)
    opts = opts or {}
    if typeof(targetCF) ~= "CFrame" then return false end

    local ok, res = runExclusive(opts.mode or "teleport", function()
        local hrp = getMyHRP()
        if not hrp then return false end

        -- 1. หยุดรอกและเก็บสายเบ็ดให้เข้า idle ก่อนเคลื่อนย้ายทุกครั้ง
        sendReel(0, true)
        setSteer(0, true)
        local tWait = os.clock()
        while (os.clock() - tWait) < 2.0 do
            local curPh = lp:GetAttribute("FishPhase") or RUNTIME.phase or "idle"
            if curPh == "idle" then break end
            if curPh == "lure" or curPh == "flight" or curPh == "pending" then
                pcall(function() Input:FireServer("cancel") end)
                task.wait(0.22)
            elseif curPh == "fight" or curPh == "strike" or curPh == "landing" then
                if opts.forceCancelFight then
                    pcall(function() Input:FireServer("cancel") end)
                    task.wait(0.22)
                else
                    return false
                end
            else
                task.wait(0.12)
            end
        end

        hrp = getMyHRP()
        if not hrp then return false end
        local hum = lp.Character and lp.Character:FindFirstChildOfClass("Humanoid")

        -- 2. ปลดเก้าอี้/เรือ และล็อกห้ามนั่งระหว่างวาร์ป
        if forceUnseat then forceUnseat(hum, hrp) end

        -- 3. วาร์ปซิงค์พิกัด + วางแผ่นรองรับ + รอพื้นจริงสตรีมโหลด (เช็คซ้ำสูงสุด 3 รอบ)
        local dist = (hrp.Position - targetCF.Position).Magnitude
        local arrived = false
        for _ = 1, 3 do
            hrp = getMyHRP()
            if not hrp then break end
            arrived = flashWarpSynced(hrp, targetCF, dist > 120 and 0.45 or 0.22, true)
            if arrived then break end
            task.wait(0.15)
        end

        -- 4. ถ้าปลายทางเป็นผิวน้ำกลางแม่น้ำ (เช่น เวิ้งน้ำลึก) ให้เสกแท่นยืนรองรับทันที ไม่จมน้ำ
        hrp = getMyHRP()
        if hrp then
            if isWaterUnderPosition(targetCF.Position) then
                if Modules.ensureEventPlatform then
                    Modules.ensureEventPlatform(targetCF.Position)
                end
            elseif Modules.destroyEventPlatform then
                Modules.destroyEventPlatform()
            end
            hrp.Anchored = false
            zeroVelocity(hrp)
        end

        -- 5. อัปเดตจุดตกปลาใหม่ (ถ้าไม่ได้วาร์ปเข้าตลาด) เพื่อไม่ให้ขายปลาเสร็จแล้วดีดกลับหมายเก่า
        if (targetCF.Position - VENDOR_COORDINATES.sell.stand).Magnitude > 25.0 then
            RUNTIME.lastFishingSpotCF = targetCF
        end
        RUNTIME.plantedStandCF = nil
        RUNTIME.usingSecondaryHand = false
        RUNTIME.phase = "idle"
        syncClientPhase("idle")

        clearFlashPad(2.0, flashPadToken)

        -- ปลดล็อกการนั่งเรือ/ช้างคืนหลังยืนนิ่งบนจุดหมายแล้ว
        if hum then
            hum.PlatformStand = false
            hum.WalkSpeed = 16
            hum.JumpHeight = 7.2
            hum.JumpPower = 50
            task.delay(0.55, function()
                if hum and hum.Parent and setAntiSeatLock then
                    setAntiSeatLock(hum, false)
                end
            end)
        end

        return arrived
    end)

    if ok and res then
        if opts.equipRod then
            task.wait(0.10)
            ensureRodEquipped()
            RUNTIME.lastCastAt = 0
        end
        return true
    end
    return false
end

local function getRodTool()
    local char = lp.Character
    local cur = char and char:FindFirstChildOfClass("Tool")
    if cur and (cur:GetAttribute("FishingRod") == true or cur.Name == "คันเบ็ด" or cur.Name:lower():match("rod")) then return cur end
    local bp = lp:FindFirstChild("Backpack")
    if bp then
        for _, item in ipairs(bp:GetChildren()) do
            if item:IsA("Tool") and (item:GetAttribute("FishingRod") == true or item.Name == "คันเบ็ด" or item.Name:lower():match("rod")) then return item end
        end
    end
    return nil
end

local function isRodEquipped()
    local char = lp.Character
    if not char then return false end
    local cur = char:FindFirstChildOfClass("Tool")
    return cur and (cur:GetAttribute("FishingRod") == true or cur.Name == "คันเบ็ด" or cur.Name:lower():match("rod"))
end

local function ensureRodEquipped()
    local char = lp.Character
    if not char then return false end
    if isRodEquipped() then return true end
    local rod = getRodTool()
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum and rod then
        hum:EquipTool(rod)
        task.wait(0.15)
        return true
    end
    return false
end

local function isLureIdNatural(lureId)
    if not lureId then return false end
    local cfg = FishingConfig.Lures and FishingConfig.Lures[lureId]
    return NATURAL_BAITS[lureId] == true or (cfg ~= nil and (cfg.Natural == true or cfg.Live == true or cfg.Bait ~= nil))
end

local function resolveRodId(rodInput)
    if not rodInput then return "bamboo" end
    local extracted = tostring(rodInput):match("%(([%w_]+)%)")
    if extracted and FishingConfig.Rods and FishingConfig.Rods[extracted] then
        return extracted
    end
    if FishingConfig.Rods and FishingConfig.Rods[rodInput] then
        return rodInput
    end
    return tostring(rodInput)
end

local function resolveRodIdFromOption(opt)
    if not opt or opt == "" or opt:find("Auto", 1, true) or opt:find("ไม่สลับ", 1, true) then
        return nil
    end
    local id = resolveRodId(opt)
    if id and FishingConfig.Rods and FishingConfig.Rods[id] then
        return id
    end
    return nil
end

local function resolveLureId(lureInput)
    if not lureInput then return "frog" end
