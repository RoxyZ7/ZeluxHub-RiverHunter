local function travelTo(targetCF, name)
    task.spawn(function()
        if not getMyHRP() then return end
        name = name or "จุดหมาย"

        if CFG.useGamepassWarp then
            local destId = boatNav.mapTargetToWarpDest(targetCF, name)
            if destId then
                local warpOk, warpReason, rem = boatNav.tryGamepassWarp(destId, 3.5)
                if warpOk then
                    notify({ Title = "⚡ วาร์ปเกมพาสสำเร็จ!", Content = "วาร์ปถึงโซน " .. tostring(destId) .. " เรียบร้อย (ไร้ Error 267)", Duration = 3 })
                    task.wait(0.20)
                    local curHrp = getMyHRP()
                    local distToGoal = curHrp and (curHrp.Position - targetCF.Position).Magnitude or 0
                    if distToGoal <= 45.0 then
                        safeGlideTo(targetCF, 14.0)
                        zeroVelocity(curHrp)
                        return
                    end
                elseif warpReason == "cooldown" then
                    notify({ Title = "⏳ วาร์ปติดคูลดาวน์", Content = string.format("เหลืออีก %d วิ สลับไปใช้การเดินทางปกติอัตโนมัติ", math.ceil(rem)), Duration = 3 })
                end
            end
        end

        if CFG.InstantTeleport then
            local ok = safeWarpToCFrame(targetCF, { mode = "teleport", equipRod = false })
            if ok then
                notify({ Title = "⚡ วาร์ปปลอดภัยสำเร็จ!", Content = "ถึง " .. name .. " เรียบร้อย (ไร้เตะ/ไร้ติดเก้าอี้)", Duration = 2.5 })
            else
                notify({ Title = "⚠️ ยังวาร์ปไม่ได้", Content = "กำลังสู้ปลาหรือติดสถานะอื่นอยู่ รอเสร็จแล้วลองใหม่", Duration = 3 })
            end
        else
            runExclusive("teleport", function()
                local hrp = getMyHRP()
                if not hrp then return end
                sendReel(0, true)
                setSteer(0, true)
                pcall(function() Input:FireServer("cancel") end)
                notify({ Title = "🚤 กำลังเดินทาง...", Content = "กำลังล่องเรือไปยัง " .. name .. " (ปลอดภัย)", Duration = 3 })
                local success = pilotBoatOrWalkRaw(targetCF, name)
                zeroVelocity(getMyHRP())
                if success then
                    if (targetCF.Position - VENDOR_COORDINATES.sell.stand).Magnitude > 25.0 then
                        RUNTIME.lastFishingSpotCF = targetCF
                    end
                    notify({ Title = "✅ ถึงจุดหมายแล้ว!", Content = name, Duration = 2.5 })
                end
            end)
        end
    end)
end

