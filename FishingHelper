local function resolvePondGeometry(myPlotId)
    myPlotId = myPlotId or lp:GetAttribute("Plot")
    if not myPlotId then return nil end

    local pondTank, cashPrompt, pondCenter, cashPos = nil, nil, nil, nil

    -- 1. Query CollectionService HomeTank
    for _, tank in ipairs(cs:GetTagged("HomeTank")) do
        if tank:GetAttribute("Plot") == myPlotId and (tank.Name == "PondTank" or tank:GetAttribute("Kind") == "pond" or tank:GetAttribute("Slot") == "pond") then
            pondTank = tank
            break
        end
    end

    -- 2. Query Town Plots model fallback
    if not pondTank then
        local town = workspace:FindFirstChild("Town")
        local plots = town and town:FindFirstChild("Plots")
        local plotFolder = plots and (plots:FindFirstChild("Plot" .. tostring(myPlotId)) or plots:FindFirstChild(tostring(myPlotId)))
        if plotFolder then
            local shop = plotFolder:FindFirstChild("Shop")
            local partPond = shop and shop:FindFirstChild("Part_pond")
            pondTank = partPond and partPond:FindFirstChild("PondTank")
        end
    end

    -- 3. Find PondCash proximity prompt
    for _, prompt in ipairs(cs:GetTagged("PondCash")) do
        if prompt:GetAttribute("Plot") == myPlotId or (prompt.Parent and prompt.Parent:GetAttribute("Plot") == myPlotId) then
            cashPrompt = prompt
            break
        end
    end

    if pondTank then
        local ok, cf = pcall(function() return pondTank:GetPivot() end)
        if ok and cf then pondCenter = cf.Position end
    end

    if cashPrompt and cashPrompt.Parent and cashPrompt.Parent:IsA("BasePart") then
        cashPos = cashPrompt.Parent.Position
    elseif pondTank and pondTank:FindFirstChild("PondCashSpot") then
        cashPos = pondTank.PondCashSpot.Position
    end

    local guardStandCF = nil
    if cashPos and pondCenter then
        local standPos = Vector3.new(cashPos.X, cashPos.Y + 1.5, cashPos.Z + 1.2)
        local lookPos = Vector3.new(pondCenter.X, standPos.Y, pondCenter.Z)
        guardStandCF = CFrame.lookAt(standPos, lookPos)
    elseif pondCenter then
        guardStandCF = CFrame.lookAt(pondCenter + Vector3.new(-10, 3.5, 0), pondCenter)
    end

    return {
        pondTank = pondTank,
        cashPrompt = cashPrompt,
        pondCenter = pondCenter,
        cashPos = cashPos,
        guardStandCF = guardStandCF
    }
end

function Modules.executePondDefenseCombat(intruderChar, geo)
    if RUNTIME.isDefendingPond then return end
    RUNTIME.isDefendingPond = true

    local prevAutoFish = CFG.AutoFish
    CFG.AutoFish = false
    pcall(function() sendReel(0, true) end)

    local intruderHrp = intruderChar:FindFirstChild("HumanoidRootPart")
    local intruderHum = intruderChar:FindFirstChildOfClass("Humanoid")
    local intruderName = intruderChar.Name

    notify({
        Title = "🚨 ขโมยบุกบ่อดิน! (Thief Detected)",
        Content = string.format("ตรวจพบ: %s กำลังเข้าใกล้บ่อดิน! ชักไม้เบสบอลเข้าตีทันที!", intruderName),
        Duration = 4
    })

    Modules.ensureBatEquipped()

    local strikeStart = os.clock()
    local maxCombatDuration = 14.0 -- Combat chase cap

    while RUNTIME.alive and (os.clock() - strikeStart) < maxCombatDuration do
        if not intruderChar or not intruderChar.Parent or not intruderHrp or not intruderHrp.Parent then break end
        if intruderHum and intruderHum.Health <= 0 then break end

        local hrp = getMyHRP()
        if not hrp then break end

        local myPos = hrp.Position
        local targetPos = intruderHrp.Position
        local distToPond = geo and geo.pondCenter and (targetPos - geo.pondCenter).Magnitude or 0
        local distToMe = (targetPos - myPos).Magnitude

        -- Stop if intruder fled beyond 50 studs of our pond and is not our direct thief
        local plr = Players:GetPlayerFromCharacter(intruderChar)
        local isDirectThief = plr and plr:GetAttribute("ThiefFrom") == lp.UserId
        if distToPond > 50.0 and not isDirectThief then
            break
        end

        -- Authoritative Bat Strike Range (<= 5.8 studs)
        if distToMe <= 5.8 then
            hrp.CFrame = CFrame.lookAt(hrp.Position, Vector3.new(targetPos.X, hrp.Position.Y, targetPos.Z))
            zeroVelocity(hrp)
            Modules.ensureBatEquipped()

            local batTool = lp.Character and (lp.Character:FindFirstChild("Bat") or lp.Character:FindFirstChildOfClass("Tool"))
            if batTool and typeof(batTool.Activate) == "function" then
                pcall(function() batTool:Activate() end)
            end
            Input:FireServer("bat")
            task.wait(0.58) -- Bat swing cooldown
        else
            -- Rapid ground-glide approach (22.0 studs/s)
            local approachPos = targetPos - ((targetPos - myPos).Unit * 3.6)
            local targetCF = CFrame.lookAt(approachPos, targetPos)
            safeGlideTo(targetCF, 22.0)
            task.wait(0.04)
        end
    end

    notify({
        Title = "🛡️ จัดการขโมยสำเร็จ (Thief Repelled)",
        Content = string.format("ขับไล่ %s พ้นเขตบ่อดินเรียบร้อย กำลังกลับจุดเฝ้าบ่อ...", intruderName),
        Duration = 4
    })

    -- Return to guard post
    if CFG.ReturnToGuardPost and geo and geo.guardStandCF then
        safeGlideTo(geo.guardStandCF, 22.0)
    end

    -- Re-equip rod & restore auto-fishing
    if prevAutoFish then
        ensureRodEquipped()
        CFG.AutoFish = true
        if RUNTIME.phase == "idle" and not RUNTIME.isSelling then
            task.spawn(function() doAutoCast() end)
        end
    end

    RUNTIME.isDefendingPond = false
end

function Modules.updatePondGuardEngine(now)
    if not CFG.PondGuard then return end
    if isBusy() and RUNTIME.busyMode ~= "pondGuard" then return end
    if (now - (RUNTIME.lastPondGuardCheckAt or 0)) < 0.40 then return end
    RUNTIME.lastPondGuardCheckAt = now

    local myPlot = lp:GetAttribute("Plot")
    if not myPlot then return end

    local geo = resolvePondGeometry(myPlot)
    if not geo or not geo.pondCenter then return end
    RUNTIME.pondCenterPos = geo.pondCenter
    if geo.guardStandCF then RUNTIME.guardStandCF = geo.guardStandCF end

    local hrp = getMyHRP()
    if not hrp then return end

    local clockTime = Lighting.ClockTime
    local isNight = (clockTime >= 19.0 or clockTime < 5.5)
    local isMorning = (clockTime >= 5.5 and clockTime <= 18.0)

    -- [SUB-ROUTINE 1]: MORNING REVENUE COLLECTION (เก็บเงินตอนเช้าอัตโนมัติ)
    if CFG.AutoMorningCollect then
        if isMorning and (RUNTIME.wasNight or (now - (RUNTIME.lastPondCollectAt or 0)) >= 60.0) then
            local pondCash = 0
            if geo.pondTank then
                pondCash = (geo.pondTank:GetAttribute("Cash") or 0) + (geo.pondTank:GetAttribute("CashNew") or 0)
            end

            local distToCash = geo.cashPos and (hrp.Position - geo.cashPos).Magnitude or 999
            if distToCash <= 35.0 then
                Input:FireServer("pondCash")
                if geo.cashPrompt and typeof(fireproximityprompt) == "function" then
                    pcall(function() fireproximityprompt(geo.cashPrompt) end)
                end
                RUNTIME.lastPondCollectAt = now
                notify({
                    Title = "🌅 เก็บเงินบ่อดินยามเช้า (Morning Harvest)",
                    Content = string.format("เก็บเงินจากบ่อดินเรียบร้อยแล้ว (สะสม: %s เหรียญ)", formatNumber(pondCash)),
                    Duration = 4
                })

                if CFG.AutoFeedPond then
                    task.delay(0.5, function()
                        Input:FireServer("feed", "pond")
                        Input:FireServer("feedLive", "pond")
                    end)
                end
            elseif CFG.ReturnToGuardPost and distToCash <= 75.0 and not RUNTIME.fightActive then
                task.spawn(function()
                    runExclusive("pondGuard", function()
                        if geo.cashPos then
                            local targetCF = CFrame.lookAt(geo.cashPos + Vector3.new(0, 1.5, 1.2), geo.pondCenter)
                            safeGlideTo(targetCF, 22.0)
                            task.wait(0.2)
                            Input:FireServer("pondCash")
                            if geo.cashPrompt and typeof(fireproximityprompt) == "function" then
                                pcall(function() fireproximityprompt(geo.cashPrompt) end)
                            end
                            RUNTIME.lastPondCollectAt = os.clock()
                        end
                    end)
                end)
            end
            RUNTIME.wasNight = false
        elseif isNight then
            RUNTIME.wasNight = true
        end
    end

    -- [SUB-ROUTINE 2]: THIEF & INTRUDER DETECTION (ตรวจจับคนมาขโมยปลา)
    if CFG.AutoBeatThieves and not RUNTIME.isDefendingPond then
        local targetIntruder, threatLevel = nil, 0
        local maxRange = CFG.PondGuardRange or 35.0

        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= lp and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
                local char = plr.Character
                local pPos = char.HumanoidRootPart.Position
                local distToPond = (pPos - geo.pondCenter).Magnitude
                local hum = char:FindFirstChildOfClass("Humanoid")
                local isAlive = hum and hum.Health > 0

                if isAlive then
                    if plr:GetAttribute("ThiefFrom") == lp.UserId then
                        targetIntruder = char
                        threatLevel = 3
                        break
                    elseif plr:GetAttribute("Thief") == true and distToPond <= 45.0 then
                        if threatLevel < 2 then
                            targetIntruder = char
                            threatLevel = 2
                        end
                    elseif distToPond <= maxRange then
                        if isNight or distToPond <= 18.0 then
                            if threatLevel < 1 then
                                targetIntruder = char
                                threatLevel = 1
                            end
                        end
                    end
                end
            end
        end

        if targetIntruder then
            task.spawn(function()
                Modules.executePondDefenseCombat(targetIntruder, geo)
            end)
        end
    end
end

